# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_PATH=./database/gym_assistant.db

# JWT
JWT_SECRET=change_this_in_real_environment
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting

# Email (Phase 4C)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Phase 3: LLM (nabh.cloud) Diet/Gym Plan Generation
LLM_API_KEY=
LLM_BASE_URL=https://api.nabh.cloud/v1
LLM_MODEL=gemma-4-26b-a4b
PLAN_VALIDITY_DAYS=7